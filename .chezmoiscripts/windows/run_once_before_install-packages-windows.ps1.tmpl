Write-Host -ForegroundColor Cyan Bootstrapping Windows Terminal...

Copy-Item {{ .chezmoi.sourceDir }}\WindowsTerminal_Profile.json $env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json
