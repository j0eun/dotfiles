Write-Host -ForegroundColor Cyan Installing packages...

winget import --import-file {{ .chezmoi.sourceDir }}\Wingetfile

Write-Host -ForegroundColor Cyan Bootstrapping Pwsh...

$pwshRoot = "$env:USERPROFILE\Documents\PowerShell"
if ( -not (Test-Path -Path $pwshRoot) ) {
    New-Item -ItemType Directory $pwshRoot
}
Copy-Item {{ .chezmoi.sourceDir }}\Microsoft.PowerShell_profile.ps1 $pwshRoot\Microsoft.PowerShell_profile.ps1

